// OneRoot ERP — agri-input store (seeds, fertilizers, pesticides, equipment)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Enums ─────────────────────────

enum Role {
  ADMIN
  MANAGER
  CASHIER
  ACCOUNTANT
}

enum ProductType {
  SEED
  FERTILIZER
  PESTICIDE
  EQUIPMENT
  OTHER
}

enum PaymentMode {
  CASH
  UPI
  CARD
  BANK
  CHEQUE
  CREDIT
  /// Kisan Credit Card — settles to the bank
  KCC
  /// Customer's credit note / advance applied to the bill (no money moves)
  CREDIT_NOTE
}

enum PaymentStatus {
  PAID
  PARTIAL
  UNPAID
}

enum DocStatus {
  COMPLETED
  CANCELLED
}

enum PurchaseOrderStatus {
  DRAFT
  PENDING_APPROVAL
  SENT_BACK
  APPROVED
  PARTIALLY_RECEIVED
  RECEIVED
  REJECTED
  CANCELLED
}

enum DebitNoteStatus {
  DRAFT
  /// Debit note sent to the vendor / credit note accepted — balances updated
  SENT
  CANCELLED
}

/// DEBIT = we claim from the vendor; CREDIT = the vendor credits us
enum NoteType {
  DEBIT
  CREDIT
}

enum NoteReason {
  RETURN
  REJECTED_AT_INWARD
  RATE_DIFFERENCE
  SHORT_SUPPLY
  DAMAGED_IN_TRANSIT
  SCHEME_INCENTIVE
  PRICE_PROTECTION
  CASH_DISCOUNT
  AGAINST_DEBIT_NOTE
  OTHER
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  DANGER
}

enum StockMovementType {
  OPENING
  PURCHASE
  PURCHASE_RETURN
  SALE
  SALE_RETURN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  EXPIRED
  DAMAGED
  TRANSFER_IN
  TRANSFER_OUT
}

enum PartyType {
  CUSTOMER
  VENDOR
}

enum PaymentDirection {
  IN // received from customer
  OUT // paid to vendor
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum ApprovalKind {
  DISCOUNT
  RETURN
  ADJUSTMENT
  OTHER
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  USED
}

enum SchemeType {
  BUY_X_GET_Y
  PCT_OFF
  FLAT_OFF
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum ReminderChannel {
  WHATSAPP
  SMS
  CALL
  VISIT
  NOTE
}

// ───────────────────────── Admin ─────────────────────────

model User {
  id                 String    @id @default(cuid())
  name               String
  email              String    @unique
  phone              String?
  passwordHash       String
  /// Approval PIN (hashed) for managers who sign off counter overrides
  pinHash            String?
  role               Role      @default(CASHIER)
  /// What this user may do, worked out = role's permissions + extraPermissions − revokedPermissions (see common/access.ts).
  /// Stored so every check and "who may approve" query reads one column; recomputed whenever the role or overrides change
  permissions        String[]  @default([])
  /// Ticked for this user on top of their role
  extraPermissions   String[]  @default([])
  /// Taken away from this user although their role has them
  revokedPermissions String[]  @default([])
  isActive           Boolean   @default(true)
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  sales      Sale[]
  purchases  Purchase[]
  quotations Quotation[]
  pettyCash  PettyCashEntry[]
  payments   Payment[]
  expenses   Expense[]
  auditLogs  AuditLog[]

  approvalSteps    ApprovalStep[]
  notifications    Notification[]
  createdPos       PurchaseOrder[]   @relation("PoCreatedBy")
  agentsDeleted    Agent[]           @relation("AgentDeletedBy")
  grns             Grn[]
  shiftsOpened     Shift[]           @relation("ShiftOpenedBy")
  approvalsAsked   ApprovalRequest[] @relation("ApprovalRequestedBy")
  approvalsDecided ApprovalRequest[] @relation("ApprovalDecidedBy")
  heldBills        HeldBill[]
  vanTrips         VanTrip[]
  attachments      Attachment[]
  /// Home branch; staff only see this branch. Empty = can work in every branch
  branchId         String?
  branch           Branch?           @relation(fields: [branchId], references: [id])
  /// Custom role this user was given (a named set of ticks); role above is its base role
  roleTemplateId   String?
  roleTemplate     RoleTemplate?     @relation(fields: [roleTemplateId], references: [id])
}

/// A custom role: a named set of permission ticks built on one of the built-in roles (which still supplies the authority limits)
/// A department groups the custom roles that belong to one function (Procurement, Sales, Warehouse...)
model Department {
  id          String   @id @default(cuid())
  /// DEPT-0001…, given on create from the "DEPT" sequence
  code        String   @unique
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles RoleTemplate[]
}

/// Permissions of a built-in role (MANAGER / ACCOUNTANT / CASHIER); ADMIN needs none. Seeded from the defaults in permissions.ts
model RolePermission {
  role        Role     @id
  permissions String[] @default([])
  updatedAt   DateTime @updatedAt
}

model RoleTemplate {
  id           String      @id @default(cuid())
  name         String      @unique
  description  String?
  /// Department this role belongs to (optional)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  baseRole     Role
  permissions  String[]    @default([])
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  users User[]
}

/// A shop or warehouse. Stock, sales and purchases belong to a branch.
model Branch {
  id        String   @id @default(cuid())
  /// Short code shown in lists, e.g. MAIN, ERD
  code      String   @unique
  name      String   @unique
  address   String?
  city      String?
  state     String?
  phone     String?
  /// Branch GSTIN if it is registered separately; otherwise the store GSTIN is used
  gstin     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  agents         Agent[]
  batches        Batch[]
  stockMovements StockMovement[]
  sales          Sale[]
  purchases      Purchase[]
  purchaseOrders PurchaseOrder[]
  grns           Grn[]
  payments       Payment[]
  expenses       Expense[]
  debitNotes     DebitNote[]
  transfersOut   StockTransfer[]   @relation("TransferFrom")
  transfersIn    StockTransfer[]   @relation("TransferTo")
  journalEntries JournalEntry[]
  shifts         Shift[]
  deposits       BankDeposit[]
  govtMatches    GovtStockMatch[]
  approvals      ApprovalRequest[]
  heldBills      HeldBill[]
  vanTrips       VanTrip[]
  quotations     Quotation[]
  pettyCash      PettyCashEntry[]
  serials        SerialNumber[]
}

/// Stock moved from one branch to another (batch, expiry and cost travel with it)
model StockTransfer {
  id           String   @id @default(cuid())
  transferNo   String   @unique
  fromBranchId String
  fromBranch   Branch   @relation("TransferFrom", fields: [fromBranchId], references: [id])
  toBranchId   String
  toBranch     Branch   @relation("TransferTo", fields: [toBranchId], references: [id])
  transferDate DateTime @default(now())
  notes        String?
  userId       String?
  createdAt    DateTime @default(now())

  items StockTransferItem[]

  @@index([transferDate])
}

model StockTransferItem {
  id          String        @id @default(cuid())
  transferId  String
  transfer    StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  productId   String
  product     Product       @relation(fields: [productId], references: [id])
  fromBatchId String
  toBatchId   String?
  batchNo     String
  expiryDate  DateTime?
  quantity    Decimal       @db.Decimal(12, 3)
  unitCost    Decimal       @db.Decimal(12, 2)
}

/// Single-row store profile used on invoices
model StoreSettings {
  id                  Int      @id @default(1)
  storeName           String   @default("OneRoot Agri Inputs")
  ownerName           String?
  phone               String?
  email               String?
  address             String?
  city                String?
  state               String?
  stateCode           String? // GST state code, e.g. "33" for Tamil Nadu
  pincode             String?
  gstin               String?
  fertilizerLicenseNo String?
  pesticideLicenseNo  String?
  seedLicenseNo       String?
  invoicePrefix       String   @default("INV")
  purchasePrefix      String   @default("PUR")
  poPrefix            String   @default("PO")
  receiptPrefix       String   @default("RCT")
  currency            String   @default("INR")
  invoiceFooter       String?  @default("Thank you for your business!")
  expiryAlertDays     Int      @default(60)
  /// Default print layout for bills: A4 invoice or thermal receipt (80 mm / 58 mm)
  receiptFormat       String   @default("A4")
  /// WhatsApp due-reminder text; {name} {amount} {store} {days} {phone} are filled in
  reminderTemplate    String?
  /// Days after the due date before a customer counts as overdue for reminders
  reminderGraceDays   Int      @default(7)
  /// Send WhatsApp reminders automatically every day (needs the WhatsApp Cloud API keys on the server)
  autoReminders       Boolean  @default(false)
  /// Refuse new credit sales to customers with overdue bills (managers can override per bill)
  blockOverdueCredit  Boolean  @default(false)
  /// No billing until the cashier opens a shift with the opening float
  requireOpenShift    Boolean  @default(false)
  updatedAt           DateTime @updatedAt
}

/// Running counters for document numbers (INV-000123 etc.)
/// Agents who bring in vendors and customers. Soft-deleted: deletedAt / deletedBy are set instead of removing the row
model Agent {
  id          String    @id @default(cuid())
  /// ORAGENT + 5-digit running number, e.g. ORAGENT00001 (never reused)
  agentId     String    @unique
  firstName   String
  lastName    String?
  /// 10-digit mobile number
  mobile      String?
  /// Branch the agent works with
  branchId    String?
  branch      Branch?   @relation(fields: [branchId], references: [id])
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?
  /// The logged-in user who deleted the agent
  deletedById String?
  deletedBy   User?     @relation("AgentDeletedBy", fields: [deletedById], references: [id])
  sales       Sale[]

  @@index([deletedAt])
  @@index([branchId])
}

model Sequence {
  key   String @id
  value Int    @default(0)
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String // CREATE / UPDATE / DELETE / CANCEL / LOGIN
  entity    String
  entityId  String?
  details    Json?
  /// The browser's own id (made once and kept in that browser), sent as X-Device-Id
  deviceId   String?
  /// Readable device from the user agent, e.g. "Chrome on Windows"
  deviceName String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
  @@index([deviceId])
}

/// A name an admin gave a device (browser), e.g. "Front Counter PC"; keyed by the browser's device id
model Device {
  /// The browser's device id (X-Device-Id)
  id           String   @id
  label        String
  labelledById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ───────────────────────── Catalogue ─────────────────────────

/// Product category (top level), e.g. Farm Machinery, Seeds. Its sub-categories live in SubCategory.
model Category {
  id            String        @id @default(cuid())
  name          String        @unique
  /// Numeric SKU code: 1, 2 … (locked once products use it)
  code          String?       @unique
  description   String?
  /// Tax type (GST / HSN defaults, govt fertiliser rules) for every product under this category
  type          ProductType?
  /// The store's own tax type (name, GST %, HSN); `type` above is the built-in type it behaves like
  taxTypeId     String?
  taxType       TaxType?      @relation(fields: [taxTypeId], references: [id])
  subCategories SubCategory[]
  products      Product[]
  createdAt     DateTime      @default(now())
}

/// A tax type categories can use: its GST / HSN / unit defaults for new products, and the built-in type
/// (seed, fertiliser, pesticide, equipment, other) it behaves like for licences and govt fertiliser rules.
/// The five built-in ones are seeded; the store adds its own when one is missing.
model TaxType {
  id         String      @id @default(cuid())
  name       String      @unique
  baseType   ProductType
  gstRate    Decimal     @default(18) @db.Decimal(5, 2)
  hsnCode    String?
  unit       String      @default("NOS")
  trackBatch Boolean     @default(false)
  /// One of the five built-in types (can't be deleted)
  builtIn    Boolean     @default(false)
  isActive   Boolean     @default(true)
  createdAt  DateTime    @default(now())
  categories Category[]
}

/// Sub-category of one Category, e.g. Farm Machinery → Tractors. Products are filed under a sub-category.
model SubCategory {
  id          String    @id @default(cuid())
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  name        String
  /// Numeric SKU code, unique within its category (locked once products use it)
  code        String?
  description String?
  /// Extra fields every product in this sub-category carries: [{ key, label, type, options?, required?, showOnBill? }]
  fields      Json?
  products    Product[]
  createdAt   DateTime  @default(now())

  @@unique([categoryId, name])
  @@unique([categoryId, code])
  @@index([categoryId])
}

model Product {
  id              String       @id @default(cuid())
  sku             String       @unique @map("sku_code")
  barcode         String?      @unique @map("barcode")
  /// Stored location of the generated barcode PNG (object storage); GET responses hand out a signed link instead
  barcodeImageUrl String?      @map("barcode_image_url")
  name            String
  type            ProductType  @default(OTHER)
  categoryId      String?
  category        Category?    @relation(fields: [categoryId], references: [id])
  subCategoryId   String?
  subCategory     SubCategory? @relation(fields: [subCategoryId], references: [id])
  brand           String?
  manufacturer    String?
  technicalName   String? // active ingredient / composition, e.g. "Imidacloprid 17.8% SL"
  description     String?
  hsnCode         String?
  gstRate         Decimal      @default(0) @db.Decimal(5, 2)
  unit            String       @default("NOS") // KG, LTR, BAG, PKT, NOS, ML, GM
  packSize        String? // e.g. "50 kg bag", "250 ml"
  mrp             Decimal      @default(0) @db.Decimal(12, 2)
  salePrice       Decimal      @default(0) @db.Decimal(12, 2)
  purchasePrice   Decimal      @default(0) @db.Decimal(12, 2)
  reorderLevel    Decimal      @default(0) @db.Decimal(12, 3)
  trackBatch      Boolean      @default(true)
  /// Govt-subsidised fertiliser: every bill line needs the govt POS receipt no. and stock is matched with the portal
  isSubsidised    Boolean      @default(false)
  /// Each unit carries a serial number (sprayers, pumps): bills pick the serials that leave
  trackSerial     Boolean      @default(false)
  /// Where it normally sits in the store: rack / bin / shelf
  location        String?
  /// Values for the category's extra fields, keyed by field key
  attributes      Json?
  isActive        Boolean      @default(true)
  // Denormalised total stock, kept in sync with batches in the same transaction
  stock           Decimal      @default(0) @db.Decimal(12, 3)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  batches            Batch[]
  stockMovements     StockMovement[]
  purchaseItems      PurchaseItem[]
  purchaseOrderItems PurchaseOrderItem[]
  grnItems           GrnItem[]
  debitNoteItems     DebitNoteItem[]
  saleItems          SaleItem[]
  quotationItems     QuotationItem[]
  saleReturnItems    SaleReturnItem[]

  transferItems StockTransferItem[]
  govtMatches   GovtStockMatch[]
  schemes       SchemeProduct[]
  serials       SerialNumber[]
  vanTripItems  VanTripItem[]
  vendors       VendorProduct[]

  @@index([name])
  @@index([type])
  @@index([isActive, name])
  @@index([categoryId])
  @@index([subCategoryId])
}

/// A lot of stock with its own batch number, expiry and cost.
/// Products without batch tracking use one "DEFAULT" batch.
model Batch {
  id         String    @id @default(cuid())
  productId  String
  product    Product   @relation(fields: [productId], references: [id])
  batchNo    String
  mfgDate    DateTime?
  expiryDate DateTime?
  costPrice  Decimal   @default(0) @db.Decimal(12, 2)
  mrp        Decimal?  @db.Decimal(12, 2)
  quantity   Decimal   @default(0) @db.Decimal(12, 3)
  /// Rack / bin this lot sits in (overrides the product's usual location)
  location   String?
  createdAt  DateTime  @default(now())

  stockMovements StockMovement[]
  purchaseItems  PurchaseItem[]
  saleItems      SaleItem[]
  serials        SerialNumber[]

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  @@unique([productId, branchId, batchNo])
  @@index([expiryDate])
  @@index([productId, quantity])
  @@index([branchId, productId])
}

/// Immutable ledger of every stock change
model StockMovement {
  id           String            @id @default(cuid())
  productId    String
  product      Product           @relation(fields: [productId], references: [id])
  batchId      String?
  batch        Batch?            @relation(fields: [batchId], references: [id])
  type         StockMovementType
  quantity     Decimal           @db.Decimal(12, 3) // signed: + in, - out
  balanceAfter Decimal           @db.Decimal(12, 3)
  unitCost     Decimal?          @db.Decimal(12, 2)
  refType      String? // SALE / PURCHASE / ADJUSTMENT / SALE_RETURN
  refId        String?
  refNo        String?
  note         String?
  userId       String?
  createdAt    DateTime          @default(now())

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  @@index([productId, createdAt])
  @@index([refType, refId])
  @@index([branchId, createdAt])
}

// ───────────────────────── Parties ─────────────────────────

model Vendor {
  id               String   @id @default(cuid())
  /// VEN-0001…, given on create from the "VEN" sequence
  code             String   @unique
  name             String
  contactPerson    String?
  phone            String?
  email            String?
  gstin            String?
  address          String?
  city             String?
  state            String?
  pincode          String?
  /// Where the vendor's bills are addressed; the form can copy it from address
  billingAddress   String?
  /// Where goods are dispatched from / shipped to; the form can copy it from address
  shippingAddress  String?
  bankName         String?
  bankAccount      String?
  ifsc             String?
  paymentTermsDays Int      @default(0)
  openingBalance   Decimal  @default(0) @db.Decimal(14, 2)
  // Amount we owe this vendor (positive = payable)
  balance          Decimal  @default(0) @db.Decimal(14, 2)
  notes            String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  purchases      Purchase[]
  purchaseOrders PurchaseOrder[]
  grns           Grn[]
  debitNotes     DebitNote[]
  payments       Payment[]
  products       VendorProduct[]

  @@index([name])
}

/// A file attached to a purchase order, GRN or debit / credit note (any type except video). The file itself is in object storage
model Attachment {
  id           String   @id @default(cuid())
  /// PO / GRN / NOTE
  entityType   String
  entityId     String
  /// Name as uploaded
  fileName     String
  mimeType     String
  /// Bytes
  size         Int
  /// Object storage key, e.g. attachments/PO/<id>/<attachment id>-invoice.pdf
  storageKey   String   @unique
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([entityType, entityId])
}

/// Products a vendor supplies: a PO for the vendor can only list these
model VendorProduct {
  vendorId  String
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([vendorId, productId])
  @@index([productId])
}

model Customer {
  id             String        @id @default(cuid())
  name           String
  phone          String?       @unique
  email          String?
  gstin          String?
  village        String?
  address        String?
  city           String?
  state          String?
  pincode        String?
  landAcres      Decimal?      @db.Decimal(8, 2)
  crops          String? // comma separated: "Paddy, Sugarcane"
  /// FPO, bulk buyer… decides an automatic discount at the counter
  customerTypeId String?
  customerType   CustomerType? @relation(fields: [customerTypeId], references: [id])
  creditLimit    Decimal       @default(0) @db.Decimal(14, 2)
  /// Credit period: unpaid bills fall due this many days after the sale (0 = due immediately)
  creditDays     Int           @default(0)
  /// Blocks further credit sales until cleared by a manager
  creditHold     Boolean       @default(false)
  openingBalance Decimal       @default(0) @db.Decimal(14, 2)
  // Amount the customer owes us (positive = receivable)
  balance        Decimal       @default(0) @db.Decimal(14, 2)
  notes          String?
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  sales       Sale[]
  saleReturns SaleReturn[]
  payments    Payment[]
  reminders   CustomerReminder[]
  heldBills   HeldBill[]
  quotations  Quotation[]

  @@index([name])
}

/// A due reminder sent to (or a collection note about) a customer
model CustomerReminder {
  id         String          @id @default(cuid())
  customerId String
  customer   Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  channel    ReminderChannel @default(WHATSAPP)
  /// Balance due when the reminder went out
  amount     Decimal         @db.Decimal(14, 2)
  message    String?
  /// true when sent by the server through the WhatsApp API rather than by a person
  automatic  Boolean         @default(false)
  userId     String?
  sentAt     DateTime        @default(now())

  @@index([customerId, sentAt])
}

// ───────────────────────── Purchasing ─────────────────────────

model PurchaseOrder {
  id                    String              @id @default(cuid())
  poNo                  String              @unique
  vendorId              String
  vendor                Vendor              @relation(fields: [vendorId], references: [id])
  orderDate             DateTime            @default(now())
  expectedDate          DateTime?
  /// How many days the PO stays valid: 7 or 14 (null on POs created before this was added)
  expiryDays            Int?
  status                PurchaseOrderStatus @default(DRAFT)
  subtotal              Decimal             @default(0) @db.Decimal(14, 2)
  taxAmount             Decimal             @default(0) @db.Decimal(14, 2)
  /// Vendor's GSTIN state differs from the delivery branch's state: GST is IGST only (else CGST + SGST)
  isInterState          Boolean             @default(false)
  /// taxAmount split by place of supply: cgst + sgst (same state) or igst (another state)
  cgst                  Decimal             @default(0) @db.Decimal(14, 2)
  sgst                  Decimal             @default(0) @db.Decimal(14, 2)
  igst                  Decimal             @default(0) @db.Decimal(14, 2)
  /// Freight / transportation on this order, before GST (taxed at transportGstRate)
  transportCharges      Decimal             @default(0) @db.Decimal(14, 2)
  /// GST % on the transportation charges (18 unless chosen otherwise)
  transportGstRate      Decimal             @default(18) @db.Decimal(5, 2)
  /// The transport amount was entered including GST (transportCharges still holds the value before GST)
  transportGstInclusive Boolean             @default(false)
  /// Any other charges (loading, packing …); otherChargesNote says what they are
  otherCharges          Decimal             @default(0) @db.Decimal(14, 2)
  /// GST % on the other charges (18 unless chosen otherwise)
  otherChargesGstRate   Decimal             @default(18) @db.Decimal(5, 2)
  otherChargesNote      String?
  /// Added to reach a whole-rupee total: .01–.49 rounds down, .50–.99 rounds up
  roundOff              Decimal             @default(0) @db.Decimal(6, 2)
  /// Items + charges (taxable value) plus GST on both, rounded to the rupee - decides the approval band
  totalAmount           Decimal             @default(0) @db.Decimal(14, 2)
  /// Approval round: goes up when a sent-back or approved PO is edited and resubmitted
  round                 Int                 @default(1)
  /// Index of the approval step currently waiting (0-based)
  level                 Int                 @default(0)
  /// Number of approval steps this PO needs, fixed when it is submitted
  levelsNeeded          Int                 @default(1)
  /// Snapshot of the approval chain taken at submission, so later rule changes don't re-route this PO
  approvalChain         Json?
  notes                 String?
  createdById           String?
  createdBy             User?               @relation("PoCreatedBy", fields: [createdById], references: [id])
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  /// Soft delete: set the day after an open PO expires (orderDate + expiryDays); hidden everywhere once set
  deletedAt             DateTime?

  items      PurchaseOrderItem[]
  purchases  Purchase[]
  history    PoHistory[]
  grns       Grn[]
  debitNotes DebitNote[]

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  @@index([status, orderDate])
  @@index([vendorId])
  @@index([deletedAt])
}

/// Every PO event: created, submitted, approved, sent back, rejected, edited, GRN posted
model PoHistory {
  id       String        @id @default(cuid())
  poId     String
  po       PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  round    Int
  action   String
  userId   String?
  userName String
  note     String?
  at       DateTime      @default(now())

  @@index([poId, at])
}

/// One link in the approval chain, e.g. 1 = Store Manager, 2 = Owner
model ApprovalStep {
  id         String  @id @default(cuid())
  order      Int     @unique
  title      String
  approverId String?
  approver   User?   @relation(fields: [approverId], references: [id])
}

/// POs with total up to `upTo` (null = no limit) need the first `steps` approval steps
model ApprovalBand {
  id    String   @id @default(cuid())
  upTo  Decimal? @db.Decimal(14, 2)
  steps Int
}

model PurchaseOrderItem {
  id          String        @id @default(cuid())
  poId        String
  po          PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  productId   String
  product     Product       @relation(fields: [productId], references: [id])
  quantity    Decimal       @db.Decimal(12, 3)
  /// Excl. GST
  rate        Decimal       @db.Decimal(12, 2)
  /// Trade discount on the line, % of quantity x rate (taken off before GST)
  discountPct Decimal       @default(0) @db.Decimal(5, 2)
  gstRate     Decimal       @default(0) @db.Decimal(5, 2)
  /// Incl. GST, after the discount
  amount      Decimal       @db.Decimal(14, 2)
  // Running totals from posted GRNs
  passedQty   Decimal       @default(0) @db.Decimal(12, 3)
  rejectedQty Decimal       @default(0) @db.Decimal(12, 3)
  damagedQty  Decimal       @default(0) @db.Decimal(12, 3)
  expiredQty  Decimal       @default(0) @db.Decimal(12, 3)

  grnItems GrnItem[]
}

/// Goods inward note: what physically arrived against a PO
model Grn {
  id                String        @id @default(cuid())
  grnNo             String        @unique
  poId              String
  po                PurchaseOrder @relation(fields: [poId], references: [id])
  vendorId          String
  vendor            Vendor        @relation(fields: [vendorId], references: [id])
  receivedAt        DateTime      @default(now())
  receivedById      String?
  receivedBy        User?         @relation(fields: [receivedById], references: [id])
  vehicleNo         String?
  /// Number on the supplier's invoice / challan that came with the goods
  supplierInvoiceNo String?
  notes             String?
  createdAt         DateTime      @default(now())

  items      GrnItem[]
  purchase   Purchase?
  debitNotes DebitNote[]

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  @@index([poId])
  @@index([receivedAt])
}

model GrnItem {
  id          String            @id @default(cuid())
  grnId       String
  grn         Grn               @relation(fields: [grnId], references: [id], onDelete: Cascade)
  poItemId    String
  poItem      PurchaseOrderItem @relation(fields: [poItemId], references: [id])
  productId   String
  product     Product           @relation(fields: [productId], references: [id])
  passedQty   Decimal           @default(0) @db.Decimal(12, 3)
  rejectedQty Decimal           @default(0) @db.Decimal(12, 3)
  damagedQty  Decimal           @default(0) @db.Decimal(12, 3)
  expiredQty  Decimal           @default(0) @db.Decimal(12, 3)
  batchNo     String?
  mfgDate     DateTime?
  expiryDate  DateTime?
  batchId     String?
  /// PO rate excl. GST
  rate        Decimal           @db.Decimal(12, 2)
}

/// Purchase return / debit note to a vendor
model DebitNote {
  id             String          @id @default(cuid())
  dnNo           String          @unique
  vendorId       String
  vendor         Vendor          @relation(fields: [vendorId], references: [id])
  grnId          String?
  grn            Grn?            @relation(fields: [grnId], references: [id])
  /// Purchase invoice the note is against (debit/credit notes legally refer to an invoice)
  purchaseId     String?
  purchase       Purchase?       @relation(fields: [purchaseId], references: [id])
  poId           String?
  po             PurchaseOrder?  @relation(fields: [poId], references: [id])
  noteType       NoteType        @default(DEBIT)
  reasonType     NoteReason      @default(OTHER)
  /// Vendor's own credit/debit note number
  vendorRef      String?
  noteDate       DateTime        @default(now())
  reason         String
  /// Where the returned goods are shipped, typed on the note (free text)
  shipTo         String?
  status         DebitNoteStatus @default(DRAFT)
  /// true = goods leave our stock and the vendor balance drops when it is sent
  affectsStock   Boolean         @default(false)
  /// true = money-only note (rate difference, scheme credit…) that changes the vendor balance when posted
  affectsBalance Boolean         @default(false)
  subtotal       Decimal         @db.Decimal(14, 2)
  taxAmount      Decimal         @db.Decimal(14, 2)
  totalAmount    Decimal         @db.Decimal(14, 2)
  userId         String?
  createdAt      DateTime        @default(now())

  items DebitNoteItem[]

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  @@index([vendorId, noteDate])
  @@index([purchaseId])
  @@index([poId])
}

model DebitNoteItem {
  id          String    @id @default(cuid())
  debitNoteId String
  debitNote   DebitNote @relation(fields: [debitNoteId], references: [id], onDelete: Cascade)
  /// Empty for value-only lines such as a scheme credit
  productId   String?
  product     Product?  @relation(fields: [productId], references: [id])
  description String?
  batchId     String?
  batchNo     String?
  quantity    Decimal   @db.Decimal(12, 3)
  rate        Decimal   @db.Decimal(12, 2)
  gstRate     Decimal   @default(0) @db.Decimal(5, 2)
  amount      Decimal   @db.Decimal(14, 2)
}

/// In-app notification for one user
model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType @default(INFO)
  title     String
  message   String?
  /// "PO Approvals", "Goods Inward", "Stock"...
  module    String
  /// Frontend route to open
  link      String?
  /// Stops duplicate system alerts (e.g. the same batch expiring) on the same day
  dedupeKey String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@unique([userId, dedupeKey])
  @@index([userId, isRead, createdAt])
}

/// Vendor bill / goods receipt. Adds stock on creation.
model Purchase {
  id              String         @id @default(cuid())
  purchaseNo      String         @unique
  vendorId        String
  vendor          Vendor         @relation(fields: [vendorId], references: [id])
  poId            String?
  po              PurchaseOrder? @relation(fields: [poId], references: [id])
  /// Invoice booked against a GRN: the stock already came in through the GRN
  grnId           String?        @unique
  grn             Grn?           @relation(fields: [grnId], references: [id])
  /// Invoice rate differs from the PO rate (three-way match failed)
  rateMismatch    Boolean        @default(false)
  vendorInvoiceNo String?
  purchaseDate    DateTime       @default(now())
  dueDate         DateTime?
  subtotal        Decimal        @db.Decimal(14, 2)
  discount        Decimal        @default(0) @db.Decimal(14, 2)
  taxAmount       Decimal        @db.Decimal(14, 2)
  otherCharges    Decimal        @default(0) @db.Decimal(14, 2)
  roundOff        Decimal        @default(0) @db.Decimal(6, 2)
  totalAmount     Decimal        @db.Decimal(14, 2)
  paidAmount      Decimal        @default(0) @db.Decimal(14, 2)
  paymentStatus   PaymentStatus  @default(UNPAID)
  status          DocStatus      @default(COMPLETED)
  notes           String?
  userId          String?
  user            User?          @relation(fields: [userId], references: [id])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  items      PurchaseItem[]
  payments   Payment[]
  debitNotes DebitNote[]

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  @@index([purchaseDate])
  @@index([vendorId])
  @@index([status, purchaseDate])
  @@index([branchId, purchaseDate])
}

model PurchaseItem {
  id            String    @id @default(cuid())
  purchaseId    String
  purchase      Purchase  @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId     String
  product       Product   @relation(fields: [productId], references: [id])
  batchId       String?
  batch         Batch?    @relation(fields: [batchId], references: [id])
  batchNo       String?
  mfgDate       DateTime?
  expiryDate    DateTime?
  quantity      Decimal   @db.Decimal(12, 3)
  freeQty       Decimal   @default(0) @db.Decimal(12, 3)
  rate          Decimal   @db.Decimal(12, 2)
  mrp           Decimal?  @db.Decimal(12, 2)
  discountPct   Decimal   @default(0) @db.Decimal(5, 2)
  gstRate       Decimal   @default(0) @db.Decimal(5, 2)
  taxableAmount Decimal   @db.Decimal(14, 2)
  taxAmount     Decimal   @db.Decimal(14, 2)
  amount        Decimal   @db.Decimal(14, 2)

  @@index([purchaseId])
}

// ───────────────────────── Sales ─────────────────────────

model Sale {
  id               String        @id @default(cuid())
  invoiceNo        String        @unique
  customerId       String?
  customer         Customer?     @relation(fields: [customerId], references: [id])
  customerName     String? // for walk-in customers
  customerPhone    String?
  saleDate         DateTime      @default(now())
  dueDate          DateTime?
  subtotal         Decimal       @db.Decimal(14, 2)
  discount         Decimal       @default(0) @db.Decimal(14, 2)
  taxAmount        Decimal       @db.Decimal(14, 2)
  cgst             Decimal       @default(0) @db.Decimal(14, 2)
  sgst             Decimal       @default(0) @db.Decimal(14, 2)
  igst             Decimal       @default(0) @db.Decimal(14, 2)
  roundOff         Decimal       @default(0) @db.Decimal(6, 2)
  totalAmount      Decimal       @db.Decimal(14, 2)
  paidAmount       Decimal       @default(0) @db.Decimal(14, 2)
  costAmount       Decimal       @default(0) @db.Decimal(14, 2) // COGS for profit reports
  paymentMode      PaymentMode   @default(CASH)
  paymentStatus    PaymentStatus @default(PAID)
  status           DocStatus     @default(COMPLETED)
  isInterState     Boolean       @default(false)
  /// Set by the POS when the bill was made offline, so a retried sync never bills twice
  offlineId        String?       @unique
  /// Where the bill was made: the counter or a van trip in the villages
  channel          SaleChannel   @default(COUNTER)
  vanTripId        String?
  vanTrip          VanTrip?      @relation(fields: [vanTripId], references: [id])
  /// Receipt no. from the government fertiliser POS device (required when a subsidised product is billed)
  govtReceiptNo    String?
  aadhaarVerified  Boolean       @default(false)
  /// Customer type whose discount applied, as named at the time
  customerTypeName String?
  /// Manager approval used for a discount above the cashier's limit
  approvalId       String?
  /// Agent who brought this sale in: internal reference only, never printed on the bill
  agentId          String?
  agent            Agent?        @relation(fields: [agentId], references: [id])
  notes            String?
  userId           String?
  user             User?         @relation(fields: [userId], references: [id])
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  items    SaleItem[]
  payments Payment[]
  returns  SaleReturn[]

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  @@index([saleDate])
  @@index([customerId])
  @@index([agentId])
  @@index([status, saleDate])
  @@index([paymentStatus])
  @@index([branchId, saleDate])
  @@index([vanTripId])
}

model SaleItem {
  id                String         @id @default(cuid())
  saleId            String
  sale              Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId         String
  product           Product        @relation(fields: [productId], references: [id])
  batchId           String?
  batch             Batch?         @relation(fields: [batchId], references: [id])
  batchNo           String?
  /// Serial-numbered units that left with this line
  serials           SerialNumber[]
  expiryDate        DateTime?
  productName       String
  hsnCode           String?
  unit              String
  quantity          Decimal        @db.Decimal(12, 3)
  rate              Decimal        @db.Decimal(12, 2) // tax-inclusive selling price per unit
  discountPct       Decimal        @default(0) @db.Decimal(5, 2)
  gstRate           Decimal        @default(0) @db.Decimal(5, 2)
  taxableAmount     Decimal        @db.Decimal(14, 2)
  taxAmount         Decimal        @db.Decimal(14, 2)
  amount            Decimal        @db.Decimal(14, 2)
  costPrice         Decimal        @default(0) @db.Decimal(12, 2)
  returnedQty       Decimal        @default(0) @db.Decimal(12, 3)
  /// Discount typed by the cashier (part of discountPct, which also holds scheme and customer-type discounts)
  manualDiscountPct Decimal        @default(0) @db.Decimal(5, 2)
  typeDiscountPct   Decimal        @default(0) @db.Decimal(5, 2)
  schemeId          String?
  scheme            Scheme?        @relation(fields: [schemeId], references: [id])
  /// Free goods line from a buy-X-get-Y scheme (rate 0, stock still goes out)
  isFree            Boolean        @default(false)

  returnItems SaleReturnItem[]

  @@index([saleId])
  @@index([productId])
}

model SaleReturn {
  id              String      @id @default(cuid())
  returnNo        String      @unique
  saleId          String
  sale            Sale        @relation(fields: [saleId], references: [id])
  customerId      String?
  customer        Customer?   @relation(fields: [customerId], references: [id])
  returnDate      DateTime    @default(now())
  totalAmount     Decimal     @db.Decimal(14, 2)
  refundMode      PaymentMode @default(CASH) // CREDIT = adjust against customer balance
  reason          String?
  /// Reversal reference on the government POS, required when subsidised fertiliser comes back
  govtReversalRef String?
  approvalId      String?
  shiftId         String?
  shift           Shift?      @relation(fields: [shiftId], references: [id])
  userId          String?
  createdAt       DateTime    @default(now())

  items SaleReturnItem[]
}

model SaleReturnItem {
  id         String     @id @default(cuid())
  returnId   String
  saleReturn SaleReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  saleItemId String
  saleItem   SaleItem   @relation(fields: [saleItemId], references: [id])
  productId  String
  product    Product    @relation(fields: [productId], references: [id])
  quantity   Decimal    @db.Decimal(12, 3)
  amount     Decimal    @db.Decimal(14, 2)
}

// ───────────────────────── Money ─────────────────────────

/// Customer receipts (IN) and vendor payments (OUT)
model Payment {
  id          String           @id @default(cuid())
  paymentNo   String           @unique
  direction   PaymentDirection
  partyType   PartyType
  customerId  String?
  customer    Customer?        @relation(fields: [customerId], references: [id])
  vendorId    String?
  vendor      Vendor?          @relation(fields: [vendorId], references: [id])
  saleId      String?
  sale        Sale?            @relation(fields: [saleId], references: [id])
  purchaseId  String?
  purchase    Purchase?        @relation(fields: [purchaseId], references: [id])
  amount      Decimal          @db.Decimal(14, 2)
  mode        PaymentMode      @default(CASH)
  reference   String? // UPI txn id, cheque no.
  paymentDate DateTime         @default(now())
  notes       String?
  userId      String?
  user        User?            @relation(fields: [userId], references: [id])
  /// Counter shift the cash moved through
  shiftId     String?
  shift       Shift?           @relation(fields: [shiftId], references: [id])
  createdAt   DateTime         @default(now())

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  @@index([paymentDate])
  @@index([customerId])
  @@index([vendorId])
  @@index([direction, paymentDate])
}

model ExpenseCategory {
  id        String           @id @default(cuid())
  name      String           @unique
  expenses  Expense[]
  pettyCash PettyCashEntry[]
  /// Ledger account the category's expenses post to (created on first use)
  account   Account?
}

model Expense {
  id          String          @id @default(cuid())
  categoryId  String
  category    ExpenseCategory @relation(fields: [categoryId], references: [id])
  amount      Decimal         @db.Decimal(14, 2)
  expenseDate DateTime        @default(now())
  mode        PaymentMode     @default(CASH)
  paidTo      String?
  reference   String?
  notes       String?
  userId      String?
  user        User?           @relation(fields: [userId], references: [id])
  shiftId     String?
  shift       Shift?          @relation(fields: [shiftId], references: [id])
  createdAt   DateTime        @default(now())

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  @@index([expenseDate])
}

// ───────────────────────── Accounting ─────────────────────────

/// Ledger account in the chart of accounts. `group` follows Tally's group names so exports map 1:1.
model Account {
  id                String           @id @default(cuid())
  code              String           @unique
  name              String           @unique
  type              AccountType
  /// e.g. "Sundry Debtors", "Duties & Taxes", "Indirect Expenses"
  group             String
  /// Fixed key used by automatic postings (CASH, BANK, DEBTORS…); such accounts cannot be deleted
  key               String?          @unique
  /// Expense category this account was created for
  expenseCategoryId String?          @unique
  expenseCategory   ExpenseCategory? @relation(fields: [expenseCategoryId], references: [id])
  /// Opening balance at the start of the books; debit positive, credit negative
  openingBalance    Decimal          @default(0) @db.Decimal(14, 2)
  isActive          Boolean          @default(true)
  createdAt         DateTime         @default(now())

  lines JournalLine[]

  @@index([type, group])
}

/// One balanced double-entry voucher. Automatic entries carry the source document in refType/refId.
model JournalEntry {
  id         String   @id @default(cuid())
  entryNo    String   @unique
  date       DateTime
  narration  String?
  /// SALE, SALE_RETURN, PURCHASE, GRN, PAYMENT, EXPENSE, DEBIT_NOTE, ADJUSTMENT, OPENING, MANUAL, REVERSAL
  refType    String
  refId      String?
  refNo      String?
  /// Entry this one reverses (sale cancelled, payment deleted…)
  reversesId String?
  isManual   Boolean  @default(false)
  branchId   String?
  branch     Branch?  @relation(fields: [branchId], references: [id])
  userId     String?
  createdAt  DateTime @default(now())

  lines JournalLine[]

  @@index([date])
  @@index([refType, refId])
}

model JournalLine {
  id          String       @id @default(cuid())
  entryId     String
  entry       JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountId   String
  account     Account      @relation(fields: [accountId], references: [id])
  debit       Decimal      @default(0) @db.Decimal(14, 2)
  credit      Decimal      @default(0) @db.Decimal(14, 2)
  /// Sub-ledger for Sundry Debtors / Creditors lines
  partyType   PartyType?
  partyId     String?
  description String?

  @@index([accountId])
  @@index([partyType, partyId])
}

// ───────────────────────── Cash control ─────────────────────────

/// One cashier's counter session: opening float in, note count at close, the amount to bank
model Shift {
  id               String      @id @default(cuid())
  shiftNo          String      @unique
  branchId         String
  branch           Branch      @relation(fields: [branchId], references: [id])
  openedById       String
  openedBy         User        @relation("ShiftOpenedBy", fields: [openedById], references: [id])
  openedAt         DateTime    @default(now())
  openingFloat     Decimal     @default(0) @db.Decimal(14, 2)
  status           ShiftStatus @default(OPEN)
  closedAt         DateTime?
  closedById       String?
  /// Opening float + cash in − cash out, worked out by the system at close
  expectedCash     Decimal?    @db.Decimal(14, 2)
  countedCash      Decimal?    @db.Decimal(14, 2)
  /// Notes counted, e.g. {"500": 280, "200": 50}
  noteCounts       Json?
  difference       Decimal?    @db.Decimal(14, 2)
  differenceReason String?
  /// Cash kept in the drawer as tomorrow's float
  floatKept        Decimal?    @db.Decimal(14, 2)
  toDeposit        Decimal?    @db.Decimal(14, 2)
  handedTo         String?
  notes            String?

  payments    Payment[]
  expenses    Expense[]
  saleReturns SaleReturn[]
  deposits    BankDeposit[]

  @@index([branchId, status])
  @@index([openedAt])
}

/// Cash banked against a closed shift. A gap against the shift's "to deposit" needs a reason and the owner's sign-off.
model BankDeposit {
  id           String    @id @default(cuid())
  depositNo    String    @unique
  shiftId      String?
  shift        Shift?    @relation(fields: [shiftId], references: [id])
  branchId     String
  branch       Branch    @relation(fields: [branchId], references: [id])
  depositDate  DateTime
  amount       Decimal   @db.Decimal(14, 2)
  bankAccount  String?
  reference    String?
  /// Slip photo, downsized by the browser and stored as a data URL
  slipImage    String?
  /// Shift's "to deposit" less everything banked including this slip; 0 when it tallies
  difference   Decimal   @default(0) @db.Decimal(14, 2)
  reason       String?
  resolvedAt   DateTime?
  resolvedById String?
  userId       String?
  createdAt    DateTime  @default(now())

  @@index([branchId, depositDate])
}

/// Daily check of subsidised fertiliser sales and stock against the government POS portal
model GovtStockMatch {
  id          String    @id @default(cuid())
  /// Local calendar day
  date        DateTime
  branchId    String
  branch      Branch    @relation(fields: [branchId], references: [id])
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  ourSales    Decimal   @db.Decimal(12, 3)
  govtSales   Decimal   @db.Decimal(12, 3)
  ourStock    Decimal   @db.Decimal(12, 3)
  portalStock Decimal   @db.Decimal(12, 3)
  note        String?
  resolvedAt  DateTime?
  userId      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([date, branchId, productId])
}

// ───────────────────────── Authority limits & approvals ─────────────────────────

/// What each role may do on its own; anything above goes to a manager (PIN at the counter or the approvals inbox).
/// A null limit means no limit.
model RoleLimit {
  role            Role     @id
  maxDiscountPct  Decimal? @db.Decimal(5, 2)
  returnLimit     Decimal? @db.Decimal(14, 2)
  adjustmentLimit Decimal? @db.Decimal(14, 2)
  seeCostPrice    Boolean  @default(false)
  updatedAt       DateTime @updatedAt
}

/// An override request: who asked, for what, who approved, and when it was used
enum SerialStatus {
  IN_STOCK
  SOLD
}

/// One serial-numbered unit of a product (sprayer, pump…): where it is, and which bill took it
model SerialNumber {
  id         String       @id @default(cuid())
  productId  String
  product    Product      @relation(fields: [productId], references: [id])
  serialNo   String
  branchId   String
  branch     Branch       @relation(fields: [branchId], references: [id])
  batchId    String?
  batch      Batch?       @relation(fields: [batchId], references: [id])
  status     SerialStatus @default(IN_STOCK)
  saleItemId String?
  saleItem   SaleItem?    @relation(fields: [saleItemId], references: [id])
  /// How it came in: GRN / PURCHASE / OPENING / ADJUSTMENT / MANUAL
  inRefType  String?
  inRefId    String?
  note       String?
  soldAt     DateTime?
  createdAt  DateTime     @default(now())

  @@unique([productId, serialNo])
  @@index([productId, branchId, status])
  @@index([saleItemId])
}

enum SaleChannel {
  COUNTER
  VAN
}

enum VanTripStatus {
  OPEN
  CLOSED
}

/// A van-stock day: stock loaded in the morning, billed on the route, reconciled in the evening
model VanTrip {
  id             String        @id @default(cuid())
  tripNo         String        @unique
  branchId       String
  branch         Branch        @relation(fields: [branchId], references: [id])
  /// Salesperson running the trip
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  date           DateTime      @default(now())
  vehicleNo      String?
  route          String?
  status         VanTripStatus @default(OPEN)
  openingCash    Decimal       @default(0) @db.Decimal(14, 2)
  cashExpected   Decimal?      @db.Decimal(14, 2)
  cashHandedOver Decimal?      @db.Decimal(14, 2)
  cashDifference Decimal?      @db.Decimal(14, 2)
  notes          String?
  closeNote      String?
  closedAt       DateTime?
  closedById     String?
  createdAt      DateTime      @default(now())

  items VanTripItem[]
  sales Sale[]

  @@index([branchId, status])
  @@index([userId, status])
}

model VanTripItem {
  id          String   @id @default(cuid())
  tripId      String
  trip        VanTrip  @relation(fields: [tripId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  loadedQty   Decimal  @db.Decimal(12, 3)
  /// Counted back at close
  returnedQty Decimal? @db.Decimal(12, 3)
  /// Missing at close (written off)
  shortQty    Decimal? @db.Decimal(12, 3)
  createdAt   DateTime @default(now())

  @@unique([tripId, productId])
}

/// A POS cart parked while the farmer fetches money / another counter serves them; recalled later on any counter
model HeldBill {
  id           String    @id @default(cuid())
  holdNo       Int
  branchId     String
  branch       Branch    @relation(fields: [branchId], references: [id])
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id])
  customerName String?
  label        String?
  total        Decimal   @db.Decimal(14, 2)
  itemCount    Int
  /// The cart exactly as the POS had it (lines, discount, mode, notes…)
  payload      Json
  createdAt    DateTime  @default(now())

  @@index([branchId, createdAt])
}

model ApprovalRequest {
  id            String         @id @default(cuid())
  kind          ApprovalKind
  amount        Decimal        @db.Decimal(14, 2)
  details       Json?
  reason        String?
  requestedById String
  requestedBy   User           @relation("ApprovalRequestedBy", fields: [requestedById], references: [id])
  status        ApprovalStatus @default(PENDING)
  decidedById   String?
  decidedBy     User?          @relation("ApprovalDecidedBy", fields: [decidedById], references: [id])
  decidedAt     DateTime?
  note          String?
  /// Approved with a manager PIN at the counter rather than from the inbox
  byPin         Boolean        @default(false)
  usedAt        DateTime?
  usedRef       String?
  branchId      String?
  branch        Branch?        @relation(fields: [branchId], references: [id])
  createdAt     DateTime       @default(now())

  @@index([status, createdAt])
  @@index([requestedById, createdAt])
}

// ───────────────────────── Schemes & customer types ─────────────────────────

/// Company scheme applied automatically at the counter: buy X get Y free, % off or flat ₹ off per unit
model Scheme {
  id        String     @id @default(cuid())
  name      String
  type      SchemeType
  buyQty    Int?
  freeQty   Int?
  pct       Decimal?   @db.Decimal(5, 2)
  flat      Decimal?   @db.Decimal(12, 2)
  from      DateTime
  to        DateTime?
  /// Cost is claimed back from the company
  claimable Boolean    @default(true)
  isActive  Boolean    @default(true)
  notes     String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  products  SchemeProduct[]
  saleItems SaleItem[]

  @@index([isActive, from])
}

model SchemeProduct {
  schemeId  String
  scheme    Scheme  @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([schemeId, productId])
}

/// Customer groups with a fixed discount, e.g. FPO 3 %, bulk buyer 2 % above ₹25,000
model CustomerType {
  id                String   @id @default(cuid())
  name              String   @unique
  discountPct       Decimal  @default(0) @db.Decimal(5, 2)
  /// Discount applies only when the bill (after schemes) reaches this amount
  minBill           Decimal  @default(0) @db.Decimal(14, 2)
  excludeSubsidised Boolean  @default(true)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())

  customers Customer[]
}

// ───────────────────────── Quotations ─────────────────────────

enum QuotationStatus {
  OPEN
  ACCEPTED
  REJECTED
  CANCELLED
}

/// Price quote for a customer, laid out like a tax invoice. Moves no stock and no money.
/// The customer's details are typed on the quote itself (the customer need not be registered).
model Quotation {
  id              String          @id @default(cuid())
  /// QTN/26-27/00001, counted per financial year
  quotationNo     String          @unique
  branchId        String?
  branch          Branch?         @relation(fields: [branchId], references: [id])
  /// Registered customer the details were filled from, if any
  customerId      String?
  customer        Customer?       @relation(fields: [customerId], references: [id])
  customerName    String
  customerPhone   String?
  customerEmail   String?
  customerGstin   String?
  customerAddress String?
  customerCity    String?
  customerState   String?
  customerPincode String?
  quotationDate   DateTime        @default(now())
  validUntil      DateTime?
  subtotal        Decimal         @db.Decimal(14, 2)
  discount        Decimal         @default(0) @db.Decimal(14, 2)
  taxAmount       Decimal         @db.Decimal(14, 2)
  cgst            Decimal         @default(0) @db.Decimal(14, 2)
  sgst            Decimal         @default(0) @db.Decimal(14, 2)
  igst            Decimal         @default(0) @db.Decimal(14, 2)
  roundOff        Decimal         @default(0) @db.Decimal(6, 2)
  totalAmount     Decimal         @db.Decimal(14, 2)
  isInterState    Boolean         @default(false)
  status          QuotationStatus @default(OPEN)
  notes           String?
  /// Terms printed at the foot of the quote (delivery, payment, validity…)
  terms           String?
  userId          String?
  user            User?           @relation(fields: [userId], references: [id])
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  items QuotationItem[]

  @@index([quotationDate])
  @@index([status, quotationDate])
  @@index([branchId, quotationDate])
  @@index([customerId])
}

model QuotationItem {
  id            String    @id @default(cuid())
  quotationId   String
  quotation     Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId     String
  product       Product   @relation(fields: [productId], references: [id])
  productName   String
  hsnCode       String?
  unit          String
  quantity      Decimal   @db.Decimal(12, 3)
  rate          Decimal   @db.Decimal(12, 2) // tax-inclusive price per unit, as on a sale
  discountPct   Decimal   @default(0) @db.Decimal(5, 2)
  gstRate       Decimal   @default(0) @db.Decimal(5, 2)
  taxableAmount Decimal   @db.Decimal(14, 2)
  taxAmount     Decimal   @db.Decimal(14, 2)
  amount        Decimal   @db.Decimal(14, 2)
  sortOrder     Int       @default(0)

  @@index([quotationId])
  @@index([productId])
}

// ───────────────────────── Petty cash ─────────────────────────

enum PettyCashType {
  /// Money put into the branch's petty-cash fund (from the cash drawer, bank or UPI)
  TOP_UP
  /// A small expense paid out of the fund, against a voucher
  SPEND
}

/// Petty-cash fund kept per branch: balance = top-ups − spends. Each entry posts to the Petty Cash ledger account.
model PettyCashEntry {
  id         String           @id @default(cuid())
  /// PCV/26-27/00001, counted per financial year
  voucherNo  String           @unique
  type       PettyCashType
  branchId   String
  branch     Branch           @relation(fields: [branchId], references: [id])
  amount     Decimal          @db.Decimal(14, 2)
  entryDate  DateTime         @default(now())
  /// Top-up: where the money came from (CASH, BANK, UPI…)
  sourceMode PaymentMode?
  /// Spend: what it was for
  categoryId String?
  category   ExpenseCategory? @relation(fields: [categoryId], references: [id])
  paidTo     String?
  /// Bill / receipt number from the shop that was paid
  billNo     String?
  notes      String?
  userId     String?
  user       User?            @relation(fields: [userId], references: [id])
  createdAt  DateTime         @default(now())

  @@index([branchId, entryDate])
  @@index([type, entryDate])
}
