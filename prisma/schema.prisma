// OneRoot ERP — agri-input store (seeds, fertilizers, pesticides, equipment)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Enums ─────────────────────────

enum Role {
  ADMIN
  MANAGER
  CASHIER
  ACCOUNTANT
}

enum ProductType {
  SEED
  FERTILIZER
  PESTICIDE
  EQUIPMENT
  OTHER
}

enum PaymentMode {
  CASH
  UPI
  CARD
  BANK
  CHEQUE
  CREDIT
}

enum PaymentStatus {
  PAID
  PARTIAL
  UNPAID
}

enum DocStatus {
  COMPLETED
  CANCELLED
}

enum PurchaseOrderStatus {
  DRAFT
  PENDING_APPROVAL
  SENT_BACK
  APPROVED
  PARTIALLY_RECEIVED
  RECEIVED
  REJECTED
  CANCELLED
}

enum DebitNoteStatus {
  DRAFT
  /// Debit note sent to the vendor / credit note accepted — balances updated
  SENT
  CANCELLED
}

/// DEBIT = we claim from the vendor; CREDIT = the vendor credits us
enum NoteType {
  DEBIT
  CREDIT
}

enum NoteReason {
  RETURN
  REJECTED_AT_INWARD
  RATE_DIFFERENCE
  SHORT_SUPPLY
  DAMAGED_IN_TRANSIT
  SCHEME_INCENTIVE
  PRICE_PROTECTION
  CASH_DISCOUNT
  AGAINST_DEBIT_NOTE
  OTHER
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  DANGER
}

enum StockMovementType {
  OPENING
  PURCHASE
  PURCHASE_RETURN
  SALE
  SALE_RETURN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  EXPIRED
  DAMAGED
  TRANSFER_IN
  TRANSFER_OUT
}

enum PartyType {
  CUSTOMER
  VENDOR
}

enum PaymentDirection {
  IN // received from customer
  OUT // paid to vendor
}

// ───────────────────────── Admin ─────────────────────────

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  phone        String?
  passwordHash String
  role         Role      @default(CASHIER)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sales     Sale[]
  purchases Purchase[]
  payments  Payment[]
  expenses  Expense[]
  auditLogs AuditLog[]

  approvalSteps ApprovalStep[]
  notifications Notification[]
  createdPos    PurchaseOrder[] @relation("PoCreatedBy")
  grns          Grn[]
  /// Home branch; staff only see this branch. Empty = can work in every branch
  branchId      String?
  branch        Branch?         @relation(fields: [branchId], references: [id])
}

/// A shop or warehouse. Stock, sales and purchases belong to a branch.
model Branch {
  id        String   @id @default(cuid())
  /// Short code shown in lists, e.g. MAIN, ERD
  code      String   @unique
  name      String   @unique
  address   String?
  city      String?
  state     String?
  phone     String?
  /// Branch GSTIN if it is registered separately; otherwise the store GSTIN is used
  gstin     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  batches        Batch[]
  stockMovements StockMovement[]
  sales          Sale[]
  purchases      Purchase[]
  purchaseOrders PurchaseOrder[]
  grns           Grn[]
  payments       Payment[]
  expenses       Expense[]
  debitNotes     DebitNote[]
  transfersOut   StockTransfer[] @relation("TransferFrom")
  transfersIn    StockTransfer[] @relation("TransferTo")
}

/// Stock moved from one branch to another (batch, expiry and cost travel with it)
model StockTransfer {
  id           String   @id @default(cuid())
  transferNo   String   @unique
  fromBranchId String
  fromBranch   Branch   @relation("TransferFrom", fields: [fromBranchId], references: [id])
  toBranchId   String
  toBranch     Branch   @relation("TransferTo", fields: [toBranchId], references: [id])
  transferDate DateTime @default(now())
  notes        String?
  userId       String?
  createdAt    DateTime @default(now())

  items StockTransferItem[]

  @@index([transferDate])
}

model StockTransferItem {
  id          String        @id @default(cuid())
  transferId  String
  transfer    StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  productId   String
  product     Product       @relation(fields: [productId], references: [id])
  fromBatchId String
  toBatchId   String?
  batchNo     String
  expiryDate  DateTime?
  quantity    Decimal       @db.Decimal(12, 3)
  unitCost    Decimal       @db.Decimal(12, 2)
}

/// Single-row store profile used on invoices
model StoreSettings {
  id                  Int      @id @default(1)
  storeName           String   @default("OneRoot Agri Inputs")
  ownerName           String?
  phone               String?
  email               String?
  address             String?
  city                String?
  state               String?
  stateCode           String? // GST state code, e.g. "33" for Tamil Nadu
  pincode             String?
  gstin               String?
  fertilizerLicenseNo String?
  pesticideLicenseNo  String?
  seedLicenseNo       String?
  invoicePrefix       String   @default("INV")
  purchasePrefix      String   @default("PUR")
  poPrefix            String   @default("PO")
  receiptPrefix       String   @default("RCT")
  currency            String   @default("INR")
  invoiceFooter       String?  @default("Thank you for your business!")
  expiryAlertDays     Int      @default(60)
  updatedAt           DateTime @updatedAt
}

/// Running counters for document numbers (INV-000123 etc.)
model Sequence {
  key   String @id
  value Int    @default(0)
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String // CREATE / UPDATE / DELETE / CANCEL / LOGIN
  entity    String
  entityId  String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

// ───────────────────────── Catalogue ─────────────────────────

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  /// Short code used as the SKU prefix for products in this category, e.g. FRT -> FRT-0001
  code        String?   @unique
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())
}

model Product {
  id            String      @id @default(cuid())
  sku           String      @unique
  barcode       String?     @unique
  name          String
  type          ProductType @default(OTHER)
  categoryId    String?
  category      Category?   @relation(fields: [categoryId], references: [id])
  brand         String?
  manufacturer  String?
  technicalName String? // active ingredient / composition, e.g. "Imidacloprid 17.8% SL"
  description   String?
  hsnCode       String?
  gstRate       Decimal     @default(0) @db.Decimal(5, 2)
  unit          String      @default("NOS") // KG, LTR, BAG, PKT, NOS, ML, GM
  packSize      String? // e.g. "50 kg bag", "250 ml"
  mrp           Decimal     @default(0) @db.Decimal(12, 2)
  salePrice     Decimal     @default(0) @db.Decimal(12, 2)
  purchasePrice Decimal     @default(0) @db.Decimal(12, 2)
  reorderLevel  Decimal     @default(0) @db.Decimal(12, 3)
  trackBatch    Boolean     @default(true)
  isActive      Boolean     @default(true)
  // Denormalised total stock, kept in sync with batches in the same transaction
  stock         Decimal     @default(0) @db.Decimal(12, 3)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  batches            Batch[]
  stockMovements     StockMovement[]
  purchaseItems      PurchaseItem[]
  purchaseOrderItems PurchaseOrderItem[]
  grnItems           GrnItem[]
  debitNoteItems     DebitNoteItem[]
  saleItems          SaleItem[]
  saleReturnItems    SaleReturnItem[]

  transferItems StockTransferItem[]

  @@index([name])
  @@index([type])
  @@index([isActive, name])
  @@index([categoryId])
}

/// A lot of stock with its own batch number, expiry and cost.
/// Products without batch tracking use one "DEFAULT" batch.
model Batch {
  id         String    @id @default(cuid())
  productId  String
  product    Product   @relation(fields: [productId], references: [id])
  batchNo    String
  mfgDate    DateTime?
  expiryDate DateTime?
  costPrice  Decimal   @default(0) @db.Decimal(12, 2)
  mrp        Decimal?  @db.Decimal(12, 2)
  quantity   Decimal   @default(0) @db.Decimal(12, 3)
  createdAt  DateTime  @default(now())

  stockMovements StockMovement[]
  purchaseItems  PurchaseItem[]
  saleItems      SaleItem[]

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  @@unique([productId, branchId, batchNo])
  @@index([expiryDate])
  @@index([productId, quantity])
  @@index([branchId, productId])
}

/// Immutable ledger of every stock change
model StockMovement {
  id           String            @id @default(cuid())
  productId    String
  product      Product           @relation(fields: [productId], references: [id])
  batchId      String?
  batch        Batch?            @relation(fields: [batchId], references: [id])
  type         StockMovementType
  quantity     Decimal           @db.Decimal(12, 3) // signed: + in, - out
  balanceAfter Decimal           @db.Decimal(12, 3)
  unitCost     Decimal?          @db.Decimal(12, 2)
  refType      String? // SALE / PURCHASE / ADJUSTMENT / SALE_RETURN
  refId        String?
  refNo        String?
  note         String?
  userId       String?
  createdAt    DateTime          @default(now())

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  @@index([productId, createdAt])
  @@index([refType, refId])
  @@index([branchId, createdAt])
}

// ───────────────────────── Parties ─────────────────────────

model Vendor {
  id               String   @id @default(cuid())
  name             String
  contactPerson    String?
  phone            String?
  email            String?
  gstin            String?
  address          String?
  city             String?
  state            String?
  pincode          String?
  bankName         String?
  bankAccount      String?
  ifsc             String?
  paymentTermsDays Int      @default(0)
  openingBalance   Decimal  @default(0) @db.Decimal(14, 2)
  // Amount we owe this vendor (positive = payable)
  balance          Decimal  @default(0) @db.Decimal(14, 2)
  notes            String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  purchases      Purchase[]
  purchaseOrders PurchaseOrder[]
  grns           Grn[]
  debitNotes     DebitNote[]
  payments       Payment[]

  @@index([name])
}

model Customer {
  id             String   @id @default(cuid())
  name           String
  phone          String?  @unique
  email          String?
  gstin          String?
  village        String?
  address        String?
  city           String?
  state          String?
  pincode        String?
  landAcres      Decimal? @db.Decimal(8, 2)
  crops          String? // comma separated: "Paddy, Sugarcane"
  creditLimit    Decimal  @default(0) @db.Decimal(14, 2)
  openingBalance Decimal  @default(0) @db.Decimal(14, 2)
  // Amount the customer owes us (positive = receivable)
  balance        Decimal  @default(0) @db.Decimal(14, 2)
  notes          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  sales       Sale[]
  saleReturns SaleReturn[]
  payments    Payment[]

  @@index([name])
}

// ───────────────────────── Purchasing ─────────────────────────

model PurchaseOrder {
  id            String              @id @default(cuid())
  poNo          String              @unique
  vendorId      String
  vendor        Vendor              @relation(fields: [vendorId], references: [id])
  orderDate     DateTime            @default(now())
  expectedDate  DateTime?
  status        PurchaseOrderStatus @default(DRAFT)
  subtotal      Decimal             @default(0) @db.Decimal(14, 2)
  taxAmount     Decimal             @default(0) @db.Decimal(14, 2)
  /// Incl. GST - decides the approval band
  totalAmount   Decimal             @default(0) @db.Decimal(14, 2)
  /// Approval round: goes up when a sent-back or approved PO is edited and resubmitted
  round         Int                 @default(1)
  /// Index of the approval step currently waiting (0-based)
  level         Int                 @default(0)
  /// Number of approval steps this PO needs, fixed when it is submitted
  levelsNeeded  Int                 @default(1)
  /// Snapshot of the approval chain taken at submission, so later rule changes don't re-route this PO
  approvalChain Json?
  notes         String?
  createdById   String?
  createdBy     User?               @relation("PoCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  items      PurchaseOrderItem[]
  purchases  Purchase[]
  history    PoHistory[]
  grns       Grn[]
  debitNotes DebitNote[]

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  @@index([status, orderDate])
  @@index([vendorId])
}

/// Every PO event: created, submitted, approved, sent back, rejected, edited, GRN posted
model PoHistory {
  id       String        @id @default(cuid())
  poId     String
  po       PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  round    Int
  action   String
  userId   String?
  userName String
  note     String?
  at       DateTime      @default(now())

  @@index([poId, at])
}

/// One link in the approval chain, e.g. 1 = Store Manager, 2 = Owner
model ApprovalStep {
  id         String  @id @default(cuid())
  order      Int     @unique
  title      String
  approverId String?
  approver   User?   @relation(fields: [approverId], references: [id])
}

/// POs with total up to `upTo` (null = no limit) need the first `steps` approval steps
model ApprovalBand {
  id    String   @id @default(cuid())
  upTo  Decimal? @db.Decimal(14, 2)
  steps Int
}

model PurchaseOrderItem {
  id          String        @id @default(cuid())
  poId        String
  po          PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  productId   String
  product     Product       @relation(fields: [productId], references: [id])
  quantity    Decimal       @db.Decimal(12, 3)
  /// Excl. GST
  rate        Decimal       @db.Decimal(12, 2)
  gstRate     Decimal       @default(0) @db.Decimal(5, 2)
  /// Incl. GST
  amount      Decimal       @db.Decimal(14, 2)
  // Running totals from posted GRNs
  passedQty   Decimal       @default(0) @db.Decimal(12, 3)
  rejectedQty Decimal       @default(0) @db.Decimal(12, 3)
  damagedQty  Decimal       @default(0) @db.Decimal(12, 3)
  expiredQty  Decimal       @default(0) @db.Decimal(12, 3)

  grnItems GrnItem[]
}

/// Goods inward note: what physically arrived against a PO
model Grn {
  id           String        @id @default(cuid())
  grnNo        String        @unique
  poId         String
  po           PurchaseOrder @relation(fields: [poId], references: [id])
  vendorId     String
  vendor       Vendor        @relation(fields: [vendorId], references: [id])
  receivedAt   DateTime      @default(now())
  receivedById String?
  receivedBy   User?         @relation(fields: [receivedById], references: [id])
  vehicleNo    String?
  notes        String?
  createdAt    DateTime      @default(now())

  items      GrnItem[]
  purchase   Purchase?
  debitNotes DebitNote[]

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  @@index([poId])
  @@index([receivedAt])
}

model GrnItem {
  id          String            @id @default(cuid())
  grnId       String
  grn         Grn               @relation(fields: [grnId], references: [id], onDelete: Cascade)
  poItemId    String
  poItem      PurchaseOrderItem @relation(fields: [poItemId], references: [id])
  productId   String
  product     Product           @relation(fields: [productId], references: [id])
  passedQty   Decimal           @default(0) @db.Decimal(12, 3)
  rejectedQty Decimal           @default(0) @db.Decimal(12, 3)
  damagedQty  Decimal           @default(0) @db.Decimal(12, 3)
  expiredQty  Decimal           @default(0) @db.Decimal(12, 3)
  batchNo     String?
  mfgDate     DateTime?
  expiryDate  DateTime?
  batchId     String?
  /// PO rate excl. GST
  rate        Decimal           @db.Decimal(12, 2)
}

/// Purchase return / debit note to a vendor
model DebitNote {
  id             String          @id @default(cuid())
  dnNo           String          @unique
  vendorId       String
  vendor         Vendor          @relation(fields: [vendorId], references: [id])
  grnId          String?
  grn            Grn?            @relation(fields: [grnId], references: [id])
  /// Purchase invoice the note is against (debit/credit notes legally refer to an invoice)
  purchaseId     String?
  purchase       Purchase?       @relation(fields: [purchaseId], references: [id])
  poId           String?
  po             PurchaseOrder?  @relation(fields: [poId], references: [id])
  noteType       NoteType        @default(DEBIT)
  reasonType     NoteReason      @default(OTHER)
  /// Vendor's own credit/debit note number
  vendorRef      String?
  noteDate       DateTime        @default(now())
  reason         String
  status         DebitNoteStatus @default(DRAFT)
  /// true = goods leave our stock and the vendor balance drops when it is sent
  affectsStock   Boolean         @default(false)
  /// true = money-only note (rate difference, scheme credit…) that changes the vendor balance when posted
  affectsBalance Boolean         @default(false)
  subtotal       Decimal         @db.Decimal(14, 2)
  taxAmount      Decimal         @db.Decimal(14, 2)
  totalAmount    Decimal         @db.Decimal(14, 2)
  userId         String?
  createdAt      DateTime        @default(now())

  items DebitNoteItem[]

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  @@index([vendorId, noteDate])
  @@index([purchaseId])
  @@index([poId])
}

model DebitNoteItem {
  id          String    @id @default(cuid())
  debitNoteId String
  debitNote   DebitNote @relation(fields: [debitNoteId], references: [id], onDelete: Cascade)
  /// Empty for value-only lines such as a scheme credit
  productId   String?
  product     Product?  @relation(fields: [productId], references: [id])
  description String?
  batchId     String?
  batchNo     String?
  quantity    Decimal   @db.Decimal(12, 3)
  rate        Decimal   @db.Decimal(12, 2)
  gstRate     Decimal   @default(0) @db.Decimal(5, 2)
  amount      Decimal   @db.Decimal(14, 2)
}

/// In-app notification for one user
model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType @default(INFO)
  title     String
  message   String?
  /// "PO Approvals", "Goods Inward", "Stock"...
  module    String
  /// Frontend route to open
  link      String?
  /// Stops duplicate system alerts (e.g. the same batch expiring) on the same day
  dedupeKey String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@unique([userId, dedupeKey])
  @@index([userId, isRead, createdAt])
}

/// Vendor bill / goods receipt. Adds stock on creation.
model Purchase {
  id              String         @id @default(cuid())
  purchaseNo      String         @unique
  vendorId        String
  vendor          Vendor         @relation(fields: [vendorId], references: [id])
  poId            String?
  po              PurchaseOrder? @relation(fields: [poId], references: [id])
  /// Invoice booked against a GRN: the stock already came in through the GRN
  grnId           String?        @unique
  grn             Grn?           @relation(fields: [grnId], references: [id])
  /// Invoice rate differs from the PO rate (three-way match failed)
  rateMismatch    Boolean        @default(false)
  vendorInvoiceNo String?
  purchaseDate    DateTime       @default(now())
  dueDate         DateTime?
  subtotal        Decimal        @db.Decimal(14, 2)
  discount        Decimal        @default(0) @db.Decimal(14, 2)
  taxAmount       Decimal        @db.Decimal(14, 2)
  otherCharges    Decimal        @default(0) @db.Decimal(14, 2)
  roundOff        Decimal        @default(0) @db.Decimal(6, 2)
  totalAmount     Decimal        @db.Decimal(14, 2)
  paidAmount      Decimal        @default(0) @db.Decimal(14, 2)
  paymentStatus   PaymentStatus  @default(UNPAID)
  status          DocStatus      @default(COMPLETED)
  notes           String?
  userId          String?
  user            User?          @relation(fields: [userId], references: [id])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  items      PurchaseItem[]
  payments   Payment[]
  debitNotes DebitNote[]

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  @@index([purchaseDate])
  @@index([vendorId])
  @@index([status, purchaseDate])
  @@index([branchId, purchaseDate])
}

model PurchaseItem {
  id            String    @id @default(cuid())
  purchaseId    String
  purchase      Purchase  @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId     String
  product       Product   @relation(fields: [productId], references: [id])
  batchId       String?
  batch         Batch?    @relation(fields: [batchId], references: [id])
  batchNo       String?
  mfgDate       DateTime?
  expiryDate    DateTime?
  quantity      Decimal   @db.Decimal(12, 3)
  freeQty       Decimal   @default(0) @db.Decimal(12, 3)
  rate          Decimal   @db.Decimal(12, 2)
  mrp           Decimal?  @db.Decimal(12, 2)
  discountPct   Decimal   @default(0) @db.Decimal(5, 2)
  gstRate       Decimal   @default(0) @db.Decimal(5, 2)
  taxableAmount Decimal   @db.Decimal(14, 2)
  taxAmount     Decimal   @db.Decimal(14, 2)
  amount        Decimal   @db.Decimal(14, 2)

  @@index([purchaseId])
}

// ───────────────────────── Sales ─────────────────────────

model Sale {
  id            String        @id @default(cuid())
  invoiceNo     String        @unique
  customerId    String?
  customer      Customer?     @relation(fields: [customerId], references: [id])
  customerName  String? // for walk-in customers
  customerPhone String?
  saleDate      DateTime      @default(now())
  dueDate       DateTime?
  subtotal      Decimal       @db.Decimal(14, 2)
  discount      Decimal       @default(0) @db.Decimal(14, 2)
  taxAmount     Decimal       @db.Decimal(14, 2)
  cgst          Decimal       @default(0) @db.Decimal(14, 2)
  sgst          Decimal       @default(0) @db.Decimal(14, 2)
  igst          Decimal       @default(0) @db.Decimal(14, 2)
  roundOff      Decimal       @default(0) @db.Decimal(6, 2)
  totalAmount   Decimal       @db.Decimal(14, 2)
  paidAmount    Decimal       @default(0) @db.Decimal(14, 2)
  costAmount    Decimal       @default(0) @db.Decimal(14, 2) // COGS for profit reports
  paymentMode   PaymentMode   @default(CASH)
  paymentStatus PaymentStatus @default(PAID)
  status        DocStatus     @default(COMPLETED)
  isInterState  Boolean       @default(false)
  notes         String?
  userId        String?
  user          User?         @relation(fields: [userId], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  items    SaleItem[]
  payments Payment[]
  returns  SaleReturn[]

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  @@index([saleDate])
  @@index([customerId])
  @@index([status, saleDate])
  @@index([paymentStatus])
  @@index([branchId, saleDate])
}

model SaleItem {
  id            String    @id @default(cuid())
  saleId        String
  sale          Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId     String
  product       Product   @relation(fields: [productId], references: [id])
  batchId       String?
  batch         Batch?    @relation(fields: [batchId], references: [id])
  batchNo       String?
  expiryDate    DateTime?
  productName   String
  hsnCode       String?
  unit          String
  quantity      Decimal   @db.Decimal(12, 3)
  rate          Decimal   @db.Decimal(12, 2) // tax-inclusive selling price per unit
  discountPct   Decimal   @default(0) @db.Decimal(5, 2)
  gstRate       Decimal   @default(0) @db.Decimal(5, 2)
  taxableAmount Decimal   @db.Decimal(14, 2)
  taxAmount     Decimal   @db.Decimal(14, 2)
  amount        Decimal   @db.Decimal(14, 2)
  costPrice     Decimal   @default(0) @db.Decimal(12, 2)
  returnedQty   Decimal   @default(0) @db.Decimal(12, 3)

  returnItems SaleReturnItem[]

  @@index([saleId])
  @@index([productId])
}

model SaleReturn {
  id          String      @id @default(cuid())
  returnNo    String      @unique
  saleId      String
  sale        Sale        @relation(fields: [saleId], references: [id])
  customerId  String?
  customer    Customer?   @relation(fields: [customerId], references: [id])
  returnDate  DateTime    @default(now())
  totalAmount Decimal     @db.Decimal(14, 2)
  refundMode  PaymentMode @default(CASH) // CREDIT = adjust against customer balance
  reason      String?
  userId      String?
  createdAt   DateTime    @default(now())

  items SaleReturnItem[]
}

model SaleReturnItem {
  id         String     @id @default(cuid())
  returnId   String
  saleReturn SaleReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  saleItemId String
  saleItem   SaleItem   @relation(fields: [saleItemId], references: [id])
  productId  String
  product    Product    @relation(fields: [productId], references: [id])
  quantity   Decimal    @db.Decimal(12, 3)
  amount     Decimal    @db.Decimal(14, 2)
}

// ───────────────────────── Money ─────────────────────────

/// Customer receipts (IN) and vendor payments (OUT)
model Payment {
  id          String           @id @default(cuid())
  paymentNo   String           @unique
  direction   PaymentDirection
  partyType   PartyType
  customerId  String?
  customer    Customer?        @relation(fields: [customerId], references: [id])
  vendorId    String?
  vendor      Vendor?          @relation(fields: [vendorId], references: [id])
  saleId      String?
  sale        Sale?            @relation(fields: [saleId], references: [id])
  purchaseId  String?
  purchase    Purchase?        @relation(fields: [purchaseId], references: [id])
  amount      Decimal          @db.Decimal(14, 2)
  mode        PaymentMode      @default(CASH)
  reference   String? // UPI txn id, cheque no.
  paymentDate DateTime         @default(now())
  notes       String?
  userId      String?
  user        User?            @relation(fields: [userId], references: [id])
  createdAt   DateTime         @default(now())

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  @@index([paymentDate])
  @@index([customerId])
  @@index([vendorId])
  @@index([direction, paymentDate])
}

model ExpenseCategory {
  id       String    @id @default(cuid())
  name     String    @unique
  expenses Expense[]
}

model Expense {
  id          String          @id @default(cuid())
  categoryId  String
  category    ExpenseCategory @relation(fields: [categoryId], references: [id])
  amount      Decimal         @db.Decimal(14, 2)
  expenseDate DateTime        @default(now())
  mode        PaymentMode     @default(CASH)
  paidTo      String?
  reference   String?
  notes       String?
  userId      String?
  user        User?           @relation(fields: [userId], references: [id])
  createdAt   DateTime        @default(now())

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  @@index([expenseDate])
}
